{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh label list:*)"
    ],
    "ask": [
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh api:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh repo delete:*)",
      "Read(./build/**)",
      "Read(./.dart_tool/**)",
      "Read(./ios/Pods/**)",
      "Read(./android/.gradle/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./android/key.properties)",
      "Read(./android/signing/**)",
      "Read(./android/app/google-services.json)",
      "Read(**/*.g.dart)",
      "Read(**/*.freezed.dart)",
      "Read(**/*.gr.dart)",
      "Read(**/*.mapper.dart)",
      "Read(**/pubspec.lock)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.dart) d=\"$CLAUDE_PROJECT_DIR/.fvm/flutter_sdk/bin/dart\"; [ -x \"$d\" ] || d=dart; \"$d\" format \"$f\" >/dev/null 2>&1 ;; esac; exit 0"
          }
        ]
      }
    ]
  }
}
