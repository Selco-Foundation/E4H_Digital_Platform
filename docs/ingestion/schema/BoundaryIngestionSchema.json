{
  "tenantId": "in",
  "module": "data-ingestion",
  "BoundaryIngestionSchema": {
    "columns": [
      {
        "name": "Country",
        "required": true,
        "type": "string",
        "pattern": "^[a-zA-Z\\s]+$",
        "mdmsSource": {
          "module": "common-masters",
          "master": "CountryInfo",
          "path": "$.name",
          "filterType": "ONE_OF"
        }
      },
      {
        "name": "State",
        "type": "string",
        "pattern": "^[A-Za-z0-9\\s.,'&()\\[\\]/*_-]+$",
        "required": true
      },
      {
        "name": "District",
        "type": "string",
        "pattern": "^[A-Za-z0-9\\s.,'&()\\[\\]/*_-]+$",
        "required": true
      },
      {
        "name": "Block",
        "type": "string",
        "pattern": "^[A-Za-z0-9\\s.,'&()\\[\\]/*_-]+$",
        "required": true
      },
      {
        "name": "LGD State Code",
        "type": "string",
        "pattern": "^\\d{1,16}$",
        "required": true
      },
      {
        "name": "LGD District Code",
        "type": "string",
        "pattern": "^\\d{1,16}$",
        "required": true
      },
      {
        "name": "LGD Block Code",
        "type": "string",
        "pattern": "^\\d{1,16}$",
        "required": true
      },
      {
        "name": "LGD Block Tier",
        "type": "string",
        "pattern": "^(Block|Sub-district|Both)$",
        "required": true
      }
    ]
  }
}
