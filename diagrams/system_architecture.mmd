graph TB
    subgraph "Frontend Layer"
        WEB[Web Application<br/>React/TypeScript]
        MOBILE[Mobile Application<br/>React Native]
        ADMIN[Admin Console<br/>React]
    end
    
    subgraph "API Gateway"
        GATEWAY[Spring Cloud Gateway<br/>Load Balancer]
    end
    
    subgraph "Microservices"
        USER[User Management Service<br/>Authentication, RBAC]
        PROJECT[Project Management Service<br/>Projects, Field Plans]
        WORKFLOW[Workflow Service<br/>Activity Management]
        NOTIFICATION[Notification Service<br/>Email, Push, SMS]
        FILE[File Management Service<br/>Upload, Storage]
        AUDIT[Audit Service<br/>Logging, Compliance]
    end
    
    subgraph "Data Layer"
        POSTGRES[(PostgreSQL<br/>Primary Database)]
        REDIS[(Redis<br/>Cache & Sessions)]
        KAFKA[Kafka<br/>Message Queue]
        MINIO[(MinIO/S3<br/>File Storage)]
        ELASTIC[(Elasticsearch<br/>Search & Analytics)]
    end
    
    subgraph "External Systems"
        MDMS[MDMS Service<br/>Master Data]
        SMS_GATEWAY[SMS Gateway<br/>Notifications]
        EMAIL_SERVICE[Email Service<br/>SMTP]
    end
    
    WEB --> GATEWAY
    MOBILE --> GATEWAY
    ADMIN --> GATEWAY
    
    GATEWAY --> USER
    GATEWAY --> PROJECT
    GATEWAY --> WORKFLOW
    GATEWAY --> NOTIFICATION
    GATEWAY --> FILE
    GATEWAY --> AUDIT
    
    USER --> POSTGRES
    PROJECT --> POSTGRES
    WORKFLOW --> POSTGRES
    AUDIT --> POSTGRES
    
    USER --> REDIS
    PROJECT --> REDIS
    
    WORKFLOW --> KAFKA
    NOTIFICATION --> KAFKA
    
    FILE --> MINIO
    
    AUDIT --> ELASTIC
    
    PROJECT --> MDMS
    NOTIFICATION --> SMS_GATEWAY
    NOTIFICATION --> EMAIL_SERVICE
    
